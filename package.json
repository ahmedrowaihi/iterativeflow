{
  "name": "iterativeflow",
  "version": "0.2.0",
  "description": "Durable, iterative workflows on your own Postgres. Steps, sleeps, hooks, loops, cron — runs inside your Node app on graphile-worker + drizzle-orm.",
  "keywords": [
    "cron",
    "drizzle",
    "durable-execution",
    "graphile-worker",
    "iterative",
    "loop",
    "orchestration",
    "postgres",
    "saga",
    "temporal",
    "trigger.dev",
    "workflow"
  ],
  "homepage": "https://github.com/ahmedrowaihi/iterativeflow#readme",
  "bugs": {
    "url": "https://github.com/ahmedrowaihi/iterativeflow/issues"
  },
  "license": "MIT",
  "author": "Ahmed Rowaihi <ahmedrowaihi1@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedrowaihi/iterativeflow.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/storage/schema.d.ts",
      "import": "./dist/storage/schema.js"
    },
    "./relations": {
      "types": "./dist/storage/relations.d.ts",
      "import": "./dist/storage/relations.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "changeset publish",
    "prepare": "lefthook install || true",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@electric-sql/pglite": "0.2.12",
    "@types/node": "^22.19.19",
    "@types/pg": "8.15.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "graphile-worker": "^0.16.6",
    "lefthook": "^2.1.8",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "pg": "8.16.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3",
    "vitest": "3.2.4",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0",
    "graphile-worker": ">=0.16.0",
    "pg": ">=8.10.0"
  },
  "engines": {
    "node": ">=20"
  }
}
