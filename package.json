{
  "name": "iterativeflow",
  "version": "3.0.2",
  "description": "Durable, iterative workflows on your own Postgres. Steps, sleeps, hooks, loops, cron — runs inside your Node app on graphile-worker + drizzle-orm.",
  "keywords": [
    "cron",
    "drizzle",
    "durable-execution",
    "graphile-worker",
    "iterative",
    "loop",
    "orchestration",
    "postgres",
    "saga",
    "temporal",
    "trigger.dev",
    "workflow"
  ],
  "homepage": "https://github.com/ahmedrowaihi/iterativeflow#readme",
  "bugs": {
    "url": "https://github.com/ahmedrowaihi/iterativeflow/issues"
  },
  "license": "MIT",
  "author": "Ahmed Rowaihi <ahmedrowaihi1@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedrowaihi/iterativeflow.git"
  },
  "bin": {
    "iterativeflow": "./dist/cli.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-schema-asset.mjs",
    "migrations:generate": "tsx scripts/generate-migrations.ts",
    "docs:check": "node scripts/extract-doc-examples.mjs && tsc -p tests/docs-examples",
    "corpus:capture": "tsx scripts/capture-corpus.ts",
    "api:check": "api-extractor run --local && node scripts/normalize-api-report.mjs && git diff --exit-code --quiet -- etc/iterativeflow.api.md",
    "api:update": "api-extractor run --local && node scripts/normalize-api-report.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "size:check": "node scripts/size-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "changeset publish",
    "prepare": "lefthook install || true",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@electric-sql/pglite": "0.2.12",
    "@microsoft/api-extractor": "^7.58.7",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^22.19.19",
    "@types/pg": "8.15.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "graphile-worker": "^0.16.6",
    "lefthook": "^2.1.8",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "pg": "8.16.0",
    "testcontainers": "^12.0.1",
    "tsdown": "^0.15.6",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "3.2.4",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0",
    "graphile-worker": ">=0.16.0",
    "pg": ">=8.10.0"
  },
  "engines": {
    "node": ">=20"
  }
}
